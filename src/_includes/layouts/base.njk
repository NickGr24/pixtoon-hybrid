<!doctype html>
<html lang="{{ t.lang }}">
<head>
  <meta charset="UTF-8" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />

  <title>{{ pageTitle or t.meta.title }}</title>
  <meta name="description" content="{{ pageDescription or t.meta.description }}" />

  {# Демо-сборка: работы клиента ещё не опубликованы, в поиск попадать не должны #}
  {% if isDemo %}<meta name="robots" content="noindex, nofollow, noimageindex" />{% endif %}
  <link rel="canonical" href="{{ site.baseUrl }}{{ page.url }}" />
  <link rel="alternate" hreflang="{{ t.lang }}" href="{{ site.baseUrl }}{{ page.url }}" />
  {% if altUrl %}<link rel="alternate" hreflang="{{ t.otherLocale.code }}" href="{{ site.baseUrl }}{{ altUrl }}" />{% endif %}

  <meta property="og:type" content="website" />
  <meta property="og:title" content="{{ pageTitle or t.meta.title }}" />
  <meta property="og:description" content="{{ pageDescription or t.meta.description }}" />
  {% if ogImage %}<meta property="og:image" content="{{ site.baseUrl }}{{ ogImage }}" />{% endif %}

  <link type="image/png" rel="shortcut icon" href="/assets/img/favicon.png" />

  {#
    Baloo 2 + Quicksand — оба шрифта макета. Poppins убран: макет набран
    Quicksand, и подмена вскрылась только на живой странице — в мелком кегле
    эти два шрифта по скриншоту неразличимы.

    latin-ext обязателен: без него ș, ț, ă, î подставятся из системного
    шрифта и румынский текст поедет по начертанию.

    Preconnect стоит выше ссылки намеренно: иначе браузер откроет соединение
    только после парсинга CSS.
  #}
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@600;700;800&family=Quicksand:wght@400;500;600;700&display=swap&subset=latin,latin-ext"
    rel="stylesheet"
  />

  {# Единственный файл стилей: оболочка и секции собраны вместе. #}
  <link rel="stylesheet" href="/assets/css/hybrid.css" />
</head>

{#
  hyb-scope переехал с <main> на <body>: шапка и футер теперь тоже наши и
  должны видеть токены. Пока раздел встраивался в чужую тему, обратное было
  верно — область намеренно не выходила за пределы контента.
#}
<body class="hyb-page hyb-scope">
  <a class="hyb-skip" href="#main">{{ "Skip to content" if t.lang == "en" else "Sari la conținut" }}</a>

  {#
    Плашка только для демо-сборки: в ней существует один раздел, остальные
    пункты меню уводят на живой pixtoon.com. Стили инлайн — в прод-CSS этому
    блоку делать нечего.
  #}
  {% if isDemo %}
  <style>
    .hyb-demobar {
      padding: 0.625rem 1rem;
      background: #231e29;
      color: #fff;
      font-family: Quicksand, system-ui, sans-serif;
      font-size: 0.8125rem;
      text-align: center;
    }
    .hyb-demobar b { color: #b99655; font-weight: 700; }
    .hyb-demobar a { color: #b9a4c9; }
  </style>
  <div class="hyb-demobar">
    {% if t.lang == "en" %}
      <b>Demo build</b> — only the Hybrid Production section is built here.
      Other menu items open the live <a href="https://pixtoon.com/">pixtoon.com</a>.
    {% else %}
      <b>Versiune demo</b> — aici este construită doar secțiunea Producție hibridă.
      Celelalte linkuri duc la <a href="https://pixtoon.com/ro/">pixtoon.com</a>.
    {% endif %}
  </div>
  {% endif %}

  {% include "partials/header.njk" %}

  <main id="main">
    {{ content | safe }}
  </main>

  {% include "partials/footer.njk" %}

  <script src="/assets/js/hybrid.js" defer></script>
</body>
</html>
