{#
  Шапка по макету base44: зафиксирована сверху, поверх первого экрана.
  Сверху прозрачная, при прокрутке сжимается и становится матовым стеклом —
  состояние переключает hybrid.js по атрибуту data-hyb-header.
  Внутренняя обёртка 1280 с полями 32 — контент 1216, как во всех секциях.

  Названия пунктов берутся из i18n, а не из макета: макет одноязычный, а
  сайт двуязычный. Состав тот же, что в макете.

  Прежняя версия воспроизводила разметку живого сайта (классы header-nav__*),
  чтобы её можно было заменить чанком MODX дословно. Это больше не верно:
  дизайн другой, и шапку придётся заводить заново. Отмечено в README.
#}
<header class="hyb-header" data-hyb-header>
  <div class="hyb-header__inner">
    {% set homeUrl = "/" if isDemo else t.dir %}
    <a href="{{ homeUrl }}" class="hyb-header__logo" aria-label="Pixtoon">
      <object type="image/svg+xml" data="/assets/img/logo.svg" tabindex="-1" aria-hidden="true"></object>
    </a>

    <button
      class="hyb-burger"
      type="button"
      aria-expanded="false"
      aria-controls="hyb-nav"
      aria-label="{{ 'Menu' if t.lang == 'en' else 'Meniu' }}"
      data-hyb-burger
    >
      <span></span><span></span><span></span>
    </button>

    <nav class="hyb-nav" id="hyb-nav">
      <ul class="hyb-nav__items">
        <li><a href="{{ t.navPaths.work | localeUrl(t) }}" class="hyb-nav__link{% if page.url == (t.navPaths.work | localeUrl(t)) %} is-current{% endif %}">{{ t.nav.work }}</a></li>
        <li><a href="{{ t.navPaths.capabilities | localeUrl(t) }}" class="hyb-nav__link{% if page.url == (t.navPaths.capabilities | localeUrl(t)) %} is-current{% endif %}">{{ t.nav.capabilities }}</a></li>
        <li>
          {#
            Скобки обязательны: в Nunjucks фильтр связывается сильнее «+», и без
            них выражение читается как hybridPath + ('/' | localeUrl), что на RO
            давало «hybrid-production/ro/» вместо «/ro/hybrid-production/».
          #}
          <a
            href="{{ (site.hybridPath + '/') | localeUrl(t) }}"
            class="hyb-nav__link{% if isHybridSection %} is-current{% endif %}"
            {% if isHybridSection %}aria-current="page"{% endif %}
          >{{ t.nav.hybrid }}</a>
        </li>
        <li><a href="{{ t.navPaths.studio | localeUrl(t) }}" class="hyb-nav__link{% if page.url == (t.navPaths.studio | localeUrl(t)) %} is-current{% endif %}">{{ t.nav.studio }}</a></li>
      </ul>

      <div class="hyb-header__actions">
        {#
          Переключатель ведёт на ту же страницу в другой локали — altUrl задан
          в front matter каждой страницы. Без него со страницы кейса посетитель
          попадал бы на общий лендинг и терял контекст.
        #}
        <a
          href="{{ altUrl if altUrl else t.otherLocale.dir + site.hybridPath + '/' }}"
          class="hyb-nav__link hyb-nav__link--lang"
          lang="{{ t.otherLocale.code }}"
          hreflang="{{ t.otherLocale.code }}"
        >{{ t.otherLocale.label }}</a>

        <a href="{{ (site.hybridPath + '/') | localeUrl(t) }}#start" class="hyb-btn hyb-btn--nav">
          {{ t.hero.ctaPrimary }}
          <span class="hyb-btn__arrow" aria-hidden="true">↗</span>
        </a>
      </div>
    </nav>
  </div>
</header>
