{#
  «Пять способов» — секция главной, переиспользуемая на /capabilities.

  showHead выключается там, где над секцией уже стоит заголовок страницы:
  в макете base44 подстраницы дублируют свой H1 в H2 секции, и на трёх
  страницах подряд один и тот же заголовок идёт дважды. Клиент попросил
  дубль убрать.
#}
<section class="hyb-section hyb-section--site hyb-section--alt" id="capabilities">
  <div class="hyb-wrap">
    {% if showHead %}
    <div class="hyb-head hyb-head--mid hyb-reveal">
      <span class="hyb-eyebrow hyb-eyebrow--pill">{{ t.capabilities.eyebrow }}</span>
      {% title t.capabilities.title, "h2", "hyb-title--site" %}
    </div>
    {% endif %}

    {% include "partials/icons-capabilities.njk" %}
    <div class="hyb-cards">
      {% for c in t.capabilities.items %}
      <article class="hyb-card hyb-reveal">
        <div class="hyb-card__head">
          <span class="hyb-card__icon" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                 stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              {{ capIcons[loop.index0] | safe }}
            </svg>
          </span>
          <span class="hyb-card__n" aria-hidden="true">{{ c.n }}</span>
        </div>
        <h3 class="hyb-card__title">{{ c.title }}</h3>
        <p class="hyb-card__text">{{ c.text }}</p>
      </article>
      {% endfor %}
    </div>
  </div>
</section>
