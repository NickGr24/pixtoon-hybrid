{#
  Витрина работ студии. Кадры чередуются формой и стороной: нечётные — круг
  слева, чётные — скруглённый прямоугольник справа. Оба параметра идут из
  данных (shape) и из позиции, а не из отдельных классов на каждый кейс.
#}
<section class="hyb-section hyb-section--site" id="work">
  <div class="hyb-wrap">
    {% if showHead %}
    <div class="hyb-head hyb-head--mid hyb-showcase-head hyb-reveal">
      <span class="hyb-eyebrow hyb-eyebrow--pill">{{ t.siteWork.eyebrow }}</span>
      {% title t.siteWork.title, "h2", "hyb-title--site" %}
    </div>
    {% endif %}

    <div class="hyb-showcase">
      {% for c in siteCases.items %}
      {% set cl = c | loc(t.locale) %}
      <article class="hyb-show hyb-show--{{ 'left' if loop.index is odd else 'right' }} hyb-reveal">
        {#
          Маска висит на обёртке, а не на самой картинке: при наведении кадр
          наезжает на 5%, и обрезать его должна форма, а не он сам — иначе
          растёт сам круг. Метка лежит снаружи обёртки, потому что в макете
          она выступает за край круга и маска бы её срезала.
        #}
        <figure class="hyb-show__media hyb-show__media--{{ c.shape }}">
          <span class="hyb-show__frame">
            <img
              src="{{ c.media }}"
              srcset="{{ c.media | replace('.jpg', '-600.jpg') }} 600w, {{ c.media | replace('.jpg', '-900.jpg') }} 900w, {{ c.media }} 1200w"
              sizes="(min-width: 56rem) 576px, 92vw"
              alt="{{ cl.title }} — {{ cl.kicker }}"
              {{ c.media | dims | safe }}
              loading="lazy"
            />
          </span>
          <figcaption class="hyb-tag hyb-tag--gold">{{ cl.tag }}</figcaption>
        </figure>
        <div class="hyb-show__body">
          <p class="hyb-show__kicker">{{ cl.kicker }}</p>
          <h3 class="hyb-show__title">{{ cl.title }}</h3>
          <p class="hyb-show__text">{{ cl.excerpt }}</p>
          <a href="{{ (site.hybridPath + '/') | localeUrl(t) }}#start" class="hyb-link">
            {{ t.siteWork.viewCase }}
            <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d="M2.5 9.5 9.5 2.5M4 2.5h5.5V8" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
        </div>
      </article>
      {% endfor %}
    </div>
  </div>
</section>
