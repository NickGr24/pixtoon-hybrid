{#
  Футер по макету base44: три колонки плюс нижняя полоса.

  Макет показывает только почту, а телефон и соцсети с живого pixtoon.com не
  выводит вовсе. Терять реальные данные из-за неполноты макета нельзя, поэтому
  они живут внутри той же трёхколоночной раскладки: соцсети под описанием,
  телефон рядом с почтой. Отмечено в списке отступлений.
#}
{% set f = site.footer[t.locale] %}
<footer class="hyb-footer">
  <div class="hyb-footer__inner">
    <div class="hyb-footer__grid">
      <div class="hyb-footer__brand">
        <a href="{{ t.dir }}" class="hyb-footer__logo" aria-label="Pixtoon">
          <object type="image/svg+xml" data="/assets/img/logo.svg" tabindex="-1" aria-hidden="true"></object>
        </a>
        <p class="hyb-footer__about">{{ f.description }}</p>
        <ul class="hyb-footer__social">
          {% for s in site.social %}
          <li>
            {#
              Название сети остаётся текстом для скринридера: логотип его не
              заменяет, а SVG помечен aria-hidden, иначе читалка объявила бы
              безымянную графику.
            #}
            <a href="{{ s.url }}" class="hyb-footer__soc" rel="noopener" target="_blank">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                {{ icons.social[s.mod] | safe }}
              </svg>
              <span class="hyb-sr">{{ s.name }}</span>
            </a>
          </li>
          {% endfor %}
        </ul>
      </div>

      <div>
        <span class="hyb-label hyb-footer__label">{{ f.navLabel }}</span>
        <ul class="hyb-footer__links">
          <li><a href="{{ t.navPaths.work | localeUrl(t) }}">{{ t.nav.work }}</a></li>
          <li><a href="{{ t.navPaths.capabilities | localeUrl(t) }}">{{ t.nav.capabilities }}</a></li>
          <li><a href="{{ (site.hybridPath + '/') | localeUrl(t) }}">{{ t.nav.hybrid }}</a></li>
          <li><a href="{{ t.navPaths.studio | localeUrl(t) }}">{{ t.nav.studio }}</a></li>
        </ul>
      </div>

      <div>
        <span class="hyb-label hyb-footer__label">{{ f.studioLabel }}</span>
        <ul class="hyb-footer__links">
          <li class="hyb-footer__contact">
            <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M13 6.7c0 3.5-5 8.3-5 8.3S3 10.2 3 6.7a5 5 0 0 1 10 0Z"/><circle cx="8" cy="6.6" r="1.8"/></svg>
            {{ site.contacts.city }}
          </li>
          <li class="hyb-footer__contact">
            <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="2" y="3.5" width="12" height="9" rx="1.5"/><path d="m2.5 4.5 5.5 4 5.5-4"/></svg>
            <a href="mailto:{{ site.contacts.email }}">{{ site.contacts.email }}</a>
          </li>
          <li class="hyb-footer__contact">
            <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M3 4.2c0-.7.6-1.2 1.2-1.2h1.9c.5 0 1 .4 1.1.9l.5 2c.1.4 0 .9-.4 1.1l-1 .7a8.4 8.4 0 0 0 3.9 3.9l.7-1c.3-.3.7-.5 1.1-.4l2 .5c.5.1.9.6.9 1.1v1.9c0 .7-.6 1.2-1.2 1.2A11 11 0 0 1 3 4.2Z"/></svg>
            <a href="{{ site.contacts.phoneHref }}">{{ site.contacts.phone }}</a>
          </li>
        </ul>
      </div>
    </div>

    <div class="hyb-footer__bottom">
      <p>{{ f.copyright }}</p>
      <p>{{ f.tagline }}</p>
    </div>
  </div>
</footer>
