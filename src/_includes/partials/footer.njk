{#
  Футер — копия существующего футера pixtoon.com (ТЗ раздел 13: «Reuse the
  existing Pixtoon footer. Do not create a different footer»). Классы, порядок
  блоков, телефон, почта и соцсети совпадают с живым сайтом, поэтому при
  интеграции блок заменяется существующим чанком один в один.
#}
{% set f = site.footer[t.locale] %}

<footer class="footer inner">
  <div class="footer__wrap">
    <div class="footer__top">
      <div class="footer__top-left">
        <a href="{{ t.dir }}" class="footer__logo" aria-label="Pixtoon">
          <object type="image/svg+xml" data="/assets/img/logo.svg"></object>
        </a>
        <div class="footer__description">{{ f.description }}</div>
      </div>

      <div class="footer__top-center">
        <nav class="footer__nav">
          <ul class="footer__items">
            <li class="footer__item">
              <a href="{{ 'about-us' | localeUrl(t) }}.html" class="footer__link">{{ t.nav.about }}</a>
            </li>
            <li class="footer__item">
              <a href="{{ 'our-work/' | localeUrl(t) }}" class="footer__link">{{ t.nav.work }}</a>
            </li>
            <li class="footer__item">
              <a href="{{ site.hybridPath + '/' | localeUrl(t) }}" class="footer__link">{{ t.nav.hybrid }}</a>
            </li>
            <li class="footer__item">
              <a href="{{ 'blog/' | localeUrl(t) }}" class="footer__link">{{ t.nav.blog }}</a>
            </li>
            <li class="footer__item">
              <a href="{{ 'contacts' | localeUrl(t) }}.html" class="footer__link">{{ t.nav.contact }}</a>
            </li>
          </ul>
        </nav>

        <div class="footer__follow">
          <div class="footer__follow-text">{{ f.followText | safe }}</div>
          <ul class="footer__follow-items">
            {% for s in site.social %}
            <li class="footer__follow-item">
              <a
                href="{{ s.url }}"
                target="_blank"
                rel="noopener"
                class="footer__follow-link footer__follow-link--{{ s.mod }}"
                aria-label="{{ s.name }}"
              ></a>
            </li>
            {% endfor %}
          </ul>
        </div>
      </div>

      <div class="footer__top-right">
        <ul class="footer__contacts">
          <li class="footer__contacts-item">
            {{ f.callUs }}
            <a href="{{ site.contacts.phoneHref }}" class="footer__contacts-phone">{{ site.contacts.phone }}</a>
          </li>
          <li class="footer__contacts-item">
            {{ f.writeUs }}
            <a href="mailto:{{ site.contacts.email }}" class="footer__contacts-email">{{ site.contacts.email }}</a>
          </li>
        </ul>
      </div>
    </div>

    <div class="footer__bottom">
      <div class="footer__bottom-left">
        <div class="footer__copyright">{{ f.copyright }}</div>
      </div>
      <div class="footer__bottom-right"></div>
    </div>
  </div>
</footer>
