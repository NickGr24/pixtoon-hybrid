---
layout: layouts/base.njk
isHybridSection: true
pagination:
  data: i18n
  size: 1
  alias: t
  resolve: values
permalink: "{{ t.dir }}{{ site.hybridPath }}/index.html"
preloadImage: /assets/img/cases/bere-chisinau.jpg
preloadSrcset: "/assets/img/cases/bere-chisinau-400.jpg 400w, /assets/img/cases/bere-chisinau-800.jpg 800w"
preloadSizes: "(min-width: 40rem) 390px, 350px"
eleventyComputed:
  pageTitle: "{{ t.meta.title | safe }}"
  pageDescription: "{{ t.meta.description | safe }}"
  altUrl: "{{ t.otherLocale.dir }}{{ site.hybridPath }}/"
---

{% import "partials/player.njk" as player %}

{% set cs = cases.featured %}

{# ============================ 1. HERO ============================ #}
<section class="hyb-hero">
  <div class="hyb-wrap">
    <div class="hyb-hero__grid">
      <div class="hyb-hero__text">
        <span class="hyb-eyebrow hyb-eyebrow--pill">{{ t.hero.eyebrow }}</span>
        {% title t.hero.title, "h1", "hyb-title--hero" %}
        <p class="hyb-lead">{{ t.hero.lead }}</p>
        <p class="hyb-hero__highlight">{{ t.hero.highlight }}</p>

        <div class="hyb-actions">
          <a href="#start" class="hyb-btn hyb-btn--primary">
            {{ t.hero.ctaPrimary }}
            <span class="hyb-btn__arrow" aria-hidden="true">↗</span>
          </a>
          <a href="#how-it-works" class="hyb-btn hyb-btn--ghost">{{ t.hero.ctaSecondary }}</a>
        </div>
      </div>

      {#
        Коллаж из пяти кадров: крупный слева, вертикальный справа, три мелких
        нижним рядом. Позиции заданы явно, а не набираются потоком — прежняя
        вёрстка на `columns: 2` балансировала высоту сама и давала рваный низ.

        Порядок свой, отличный от порядка кейсов в секции работ, и задан
        клиентом вручную в макете 17.08: Berea Chișinău в крупной ячейке,
        Drive Gas — в мелкой. Читать порядок из cases.json нельзя, там он
        другой; список ниже и есть источник истины для коллажа.
      #}
      <div class="hyb-hero__visual">
        <div class="hyb-collage">
          {% set collageSlugs = ["bere-chisinau", "coccolino", "medpark-mafa-girafa", "drive-gas", "microinvest-family"] %}
          {#
            Ширина ячейки на телефоне не совпадает с шириной на широком
            экране, и наоборот: крупная ячейка макета на узком экране —
            вертикаль в половину ширины, а Coccolino, наоборот, растягивается
            на обе колонки. Один общий `sizes` на все пять врал бы браузеру
            в обе стороны, поэтому набор перечислен по позициям.
          #}
          {% set collageSizes = [
            "(min-width: 40rem) 390px, 170px",
            "(min-width: 40rem) 190px, 350px",
            "(min-width: 40rem) 190px, 170px",
            "(min-width: 40rem) 190px, 170px",
            "(min-width: 40rem) 190px, 170px"
          ] %}
          {% for slug in collageSlugs %}
          {% set pos = loop.index %}
          {% for c in cs %}{% if c.slug == slug %}
          {% set cl = c | loc(t.locale) %}
          {#
            Ячейка коллажа — ссылка на страницу кейса, а не просто кадр.
            Доступное имя даёт aria-label: alt картинки и подпись под ней
            повторяют одно и то же название, и без него скринридер читал бы
            его дважды подряд.
          #}
          <a
            class="hyb-collage__item hyb-collage__item--{{ pos }}"
            href="{{ (site.hybridPath + '/' + c.slug + '/') | localeUrl(t) }}"
            aria-label="{{ cl.title }} — {{ cl.tags }}"
          >
            {#
              Ячейки коллажа — от 169 до 389px, а исходники кадров до 1600.
              Без srcset первый экран тянул три четверти мегабайта ради
              картинок размером с почтовую марку, и LCP на телефоне уходил
              за четыре секунды.
            #}
            <img
              class="hyb-collage__media"
              src="{{ c.media.poster }}"
              srcset="{{ c.media.poster | replace('.jpg', '-400.jpg') }} 400w, {{ c.media.poster | replace('.jpg', '-800.jpg') }} 800w"
              sizes="{{ collageSizes[pos - 1] }}"
              alt=""
              {{ c.media.poster | dims | safe }}
              style="object-position: {{ c.media.focal }}"
              loading="{{ 'eager' if pos == 1 else 'lazy' }}"
              {% if pos == 1 %}fetchpriority="high"{% endif %}
            />
            <span class="hyb-tag hyb-tag--gold">{{ cl.title }}</span>
          </a>
          {% endif %}{% endfor %}
          {% endfor %}
        </div>
      </div>
    </div>
  </div>
</section>

{# ==================== 2. SELECTED HYBRID WORK ==================== #}
<section class="hyb-section" id="work">
  <div class="hyb-wrap">
    <div class="hyb-head hyb-reveal">
      <span class="hyb-eyebrow">{{ t.work.eyebrow }}</span>
      {% title t.work.title, "h2", "hyb-title--sm" %}
    </div>

    {#
      Бенто: крупный кейс на две колонки, рядом высокий, снизу три ровных.
      Позиции заданы классами --1..--5, поэтому перестановка данных не может
      случайно сломать раскладку.
    #}
    <div class="hyb-work">
      {% for c in cs %}
      {% set cl = c | loc(t.locale) %}
      <a
        class="hyb-case hyb-case--{{ loop.index }} hyb-reveal"
        href="{{ (site.hybridPath + '/' + c.slug + '/') | localeUrl(t) }}"
        data-hyb-hover-video
      >
        <div class="hyb-case__frame">
          <img
            class="hyb-case__media"
            src="{{ c.media.poster }}"
            alt=""
            {{ c.media.poster | dims | safe }}
            style="object-position: {{ c.media.focal }}"
            loading="lazy"
          />
          {% if c.media.hasPreview %}
          <video
            class="hyb-case__video"
            data-src="{{ c.media.preview | url }}"
            muted loop playsinline preload="none" aria-hidden="true"
          ></video>
          {% endif %}
        </div>
        <div class="hyb-case__body">
          <span class="hyb-tag hyb-tag--glass">{{ cl.tags }}</span>
          <h3 class="hyb-case__title">{{ cl.title }}</h3>
          {#
            Подпись есть у всех карточек, а не только у первой. Раньше здесь
            стоял excerpt — он длинный, потому что служит ещё и описанием
            страницы кейса в поиске, и на четырёх мелких плитках бенто не
            помещался. Документ клиента даёт под каждый кейс отдельную
            строку в одно предложение, она и стоит здесь.
          #}
          <p class="hyb-case__excerpt">{{ cl.card }}</p>
          <span class="hyb-case__cta">
            {{ t.work.viewCase }}
            <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d="M2.5 9.5 9.5 2.5M4 2.5h5.5V8" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </span>
        </div>
      </a>
      {% endfor %}
    </div>
  </div>
</section>

{# ==================== 3. MONTHLY / ABONAMENTE ==================== #}
<section class="hyb-section hyb-section--alt hyb-section--roomy" id="monthly">
  <div class="hyb-wrap">
    <div class="hyb-head hyb-head--wide hyb-reveal">
      <span class="hyb-eyebrow">{{ t.monthly.eyebrow }}</span>
      {% title t.monthly.title, "h2", "hyb-title--lg" %}
      <p class="hyb-subtitle">{{ t.monthly.subtitle }}</p>
      <p class="hyb-lead">{{ t.monthly.lead }}</p>
    </div>

    <div class="hyb-packages">
      {% for p in t.monthly.packages %}
      <article class="hyb-package hyb-reveal">
        <div class="hyb-package__head">
          <p class="hyb-eyebrow hyb-eyebrow--gold hyb-package__label">{{ p.label }}</p>
          <p class="hyb-package__price">
            {{ p.price }}<span class="hyb-package__per">{{ t.monthly.perMonth }}</span>
          </p>
        </div>
        <h3 class="hyb-package__title">{{ p.title }}</h3>

        {#
          Кадр подписан именем кейса и его ролью. Раньше он подставлялся
          формулой featured[index+1] — связи с содержанием пакета не было
          вообще, и Coccolino оказывался в пакете «2 video AI/3D» без причин.
        #}
        {#
          Кадр запускает ролик кейса по нажатию, а не по наведению. Ролик со
          звуком и весит мегабайты: браузер не даст ему стартовать без жеста,
          да и качать его из-за случайного пролёта курсора незачем.
        #}
        <div class="hyb-package__media" data-hyb-player>
          <img class="hyb-case__media" src="{{ p.mediaSrc }}" alt="{{ p.mediaLabel }}" {{ p.mediaSrc | dims | safe }} loading="lazy" />
          <span class="hyb-tag hyb-tag--gold hyb-package__tag">
            <span aria-hidden="true">✦</span> {{ p.mediaLabel }}
          </span>
          {#
            Путь к ролику берётся из кейса, а не переписывается в локаль: там
            же считается, лежит ли файл на диске. Пакет называет только слаг.
          #}
          {% for c in cs %}{% if c.slug == p.caseSlug and c.media.hasVideo %}
          {{ player.overlay(icons, t.caseStudy.player, c.media.video | url, p.mediaSrc, "hyb-play hyb-play--btn") }}
          {% endif %}{% endfor %}
        </div>

        <div class="hyb-package__cols">
          <div>
            <span class="hyb-label">{{ t.monthly.idealLabel }}</span>
            <ul class="hyb-checks">
              {% for i in p.idealFor %}<li class="hyb-checks__item">{{ i }}</li>{% endfor %}
            </ul>
          </div>
          <div>
            <span class="hyb-label">{{ t.monthly.includesLabel }}</span>
            <ul class="hyb-checks">
              {% for i in p.items %}<li class="hyb-checks__item">{{ i }}</li>{% endfor %}
            </ul>
          </div>
        </div>

        <a href="#start" class="hyb-btn hyb-btn--dark">
          {{ t.monthly.cta }}
          <span class="hyb-btn__arrow" aria-hidden="true">↗</span>
        </a>
      </article>
      {% endfor %}
    </div>

    {#
      Кастомный пакет: тёмная карточка, расколотая пополам кадром.

      Кадр почти квадратный и снят из ролика Drive Gas: высоту его колонки
      задаёт текст рядом, то есть пропорция плавает около единицы. Прежний
      кадр был горизонтальный 16:10 с надписью — в такую колонку он влезал
      средней третью и разрезал разом и надпись, и лицо маскота.
    #}
    <div class="hyb-custom hyb-invert hyb-reveal">
      {% set customShot = "/assets/img/drive-gas/mascot.jpg" %}
      <div class="hyb-custom__media">
        <img src="{{ customShot }}" srcset="{{ customShot | srcset }}"
             sizes="(min-width: 56rem) 547px, 100vw"
             alt="" {{ customShot | dims | safe }} loading="lazy" />
      </div>
      <div class="hyb-custom__body">
        <p class="hyb-eyebrow hyb-eyebrow--gold">{{ t.monthly.custom.label }}</p>
        <h3 class="hyb-custom__title">{{ t.monthly.custom.title }}</h3>
        <span class="hyb-label hyb-custom__kicker">{{ t.monthly.custom.itemsLabel }}</span>
        <ul class="hyb-chips">
          {% for i in t.monthly.custom.items %}<li class="hyb-chip">{{ i }}</li>{% endfor %}
        </ul>
        <a href="#start" class="hyb-btn hyb-btn--primary hyb-btn--sm">
          {{ t.monthly.custom.cta }}
          <span class="hyb-btn__arrow" aria-hidden="true">↗</span>
        </a>
      </div>
    </div>

    <div class="hyb-closing hyb-reveal">
      <div>
        <span class="hyb-eyebrow">{{ t.monthly.closing.eyebrow }}</span>
        {% title t.monthly.closing.title, "h3" %}
      </div>
      <div>
        <p class="hyb-closing__text">{{ t.monthly.closing.text }}</p>
        <p class="hyb-closing__text">{{ t.monthly.closing.text2 }}</p>
      </div>
    </div>
  </div>
</section>

{# =================== 4. CASE STUDY — MICROINVEST ================= #}
<section class="hyb-section" id="microinvest">
  <div class="hyb-wrap">
    <div class="hyb-head hyb-head--wide hyb-reveal">
      <span class="hyb-eyebrow">{{ t.microinvest.eyebrow }}</span>
      {% title t.microinvest.title %}
      <p class="hyb-lead">{{ t.microinvest.lead }}</p>
    </div>

    {#
      Триптих: слева сам ролик, справа два кадра из него. Все три колонки в
      пропорции материала — рил вертикальный 1080×1916, и горизонтальная
      плитка, которая стояла здесь раньше, срезала персонажам головы.

      Кадры взяты из того же mp4 скриптом tools/microinvest-frames.mjs, а не
      подобраны отдельными файлами: иначе связь «что на плитке» с «что в
      ролике» держалась бы только на памяти.
    #}
    <div class="hyb-mi__top hyb-reveal">
      {% set miPoster = "/assets/img/cases/microinvest-family.jpg" %}
      <figure class="hyb-mi__hero" data-hyb-player>
        <img src="{{ miPoster }}" srcset="{{ miPoster | srcset }}"
             sizes="(min-width: 56rem) 392px, 92vw"
             alt="{{ t.microinvest.heroCaption }}" {{ miPoster | dims | safe }} loading="lazy" />
        <figcaption>
          <span class="hyb-tag hyb-tag--gold"><span aria-hidden="true">✦</span> {{ t.microinvest.heroLabel }}</span>
          <span class="hyb-mi__caption">{{ t.microinvest.heroCaption }}</span>
        </figcaption>
        {% for c in cs %}{% if c.slug == "microinvest-family" and c.media.hasVideo %}
        {{ player.overlay(icons, t.caseStudy.player, c.media.video | url, miPoster) }}
        {% endif %}{% endfor %}
      </figure>

      {% set miTiles = ["reel-scene", "reel-closeup"] %}
      {% for slot in miTiles %}
      {% set src = "/assets/img/microinvest/" + slot + ".jpg" %}
      <figure class="hyb-mi__tile">
        <img src="{{ src }}" srcset="{{ src | srcset }}"
             sizes="(min-width: 56rem) 392px, 44vw"
             alt="{{ t.microinvest.sideLabels[loop.index0] }}" {{ src | dims | safe }} loading="lazy" />
        <figcaption class="hyb-tag hyb-tag--light">{{ t.microinvest.sideLabels[loop.index0] }}</figcaption>
      </figure>
      {% endfor %}
    </div>

    {#
      Подписи лежат прямо на кадре без затемняющего градиента — как в макете.
      Работает потому, что все четыре портрета подобраны с тёмным низом;
      страховкой служит тень глифа, а не заливка поверх изображения.
    #}
    <div class="hyb-mi__portraits hyb-reveal">
      {#
        Отец идёт под своим именем `tatal-portret`: файл `tatal.jpg` в той же
        папке служит исходником для шага процесса на странице кейса, и
        перерезать его под этот ряд значило бы менять заодно и тот шаг.
      #}
      {% set files = ["mama", "fiica", "tatal-portret", "pisica"] %}
      {% for name in t.microinvest.portraits %}
      {% set portrait = "/assets/img/microinvest/" + files[loop.index0] + ".jpg" %}
      <figure class="hyb-mi__portrait">
        <img src="{{ portrait }}" srcset="{{ portrait | srcset }}"
             sizes="(min-width: 56rem) 289px, 45vw"
             alt="{{ name }}" {{ portrait | dims | safe }} loading="lazy" />
        <figcaption>{{ name }}</figcaption>
      </figure>
      {% endfor %}
    </div>

    <div class="hyb-mi__features hyb-reveal">
      {% for f in t.microinvest.features %}
      <div class="hyb-feature">
        <span class="hyb-feature__icon" aria-hidden="true">
          <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="7" cy="6" r="3" /><path d="M2 17c0-2.8 2.2-5 5-5s5 2.2 5 5" /><path d="M14 4.5a3 3 0 0 1 0 5.8M16 13.5c1.4.9 2.3 2.4 2.3 4" />
          </svg>
        </span>
        <h3 class="hyb-feature__title">{{ f.title }}</h3>
        <p class="hyb-feature__text">{{ f.text }}</p>
      </div>
      {% endfor %}
    </div>

    <div class="hyb-mi__why hyb-reveal">
      <div>
        <span class="hyb-eyebrow">{{ t.microinvest.why.eyebrow }}</span>
        {% title t.microinvest.why.title, "h3", "hyb-title--h3" %}
      </div>
      <div>
        <p class="hyb-closing__text">{{ t.microinvest.why.text }}</p>
        <p class="hyb-closing__text">{{ t.microinvest.why.text2 }}</p>
        <a href="#start" class="hyb-link hyb-link--accent">
          {{ t.microinvest.why.cta }}
          <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d="M2.5 9.5 9.5 2.5M4 2.5h5.5V8" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
      </div>
    </div>
  </div>
</section>

{# ================ 5. HOW HYBRID PRODUCTION WORKS ================= #}
<section class="hyb-section" id="how-it-works">
  <div class="hyb-wrap">
    <div class="hyb-head hyb-head--mid hyb-reveal">
      <span class="hyb-eyebrow">{{ t.process.eyebrow }}</span>
      {% title t.process.title %}
      <p class="hyb-lead">{{ t.process.lead }}</p>
    </div>

    <ol class="hyb-steps">
      {% for s in t.process.steps %}
      <li class="hyb-step hyb-reveal">
        <span class="hyb-step__n" aria-hidden="true">{{ s.n }}</span>
        <h3 class="hyb-step__title">{{ s.title }}</h3>
        <p class="hyb-step__text">{{ s.text }}</p>
      </li>
      {% endfor %}
    </ol>
  </div>
</section>

{# ======================= 6. CIFRELE VORBESC ====================== #}
<section class="hyb-section hyb-section--alt">
  <div class="hyb-wrap">
    <div class="hyb-head hyb-reveal">
      <span class="hyb-eyebrow">{{ t.stats.eyebrow }}</span>
      {% title t.stats.title %}
    </div>

    <div class="hyb-stats">
      {% for s in t.stats.items %}
      <div class="hyb-stat hyb-reveal">
        <p class="hyb-stat__value">{{ s.value }}</p>
        <p class="hyb-stat__label">{{ s.label }}</p>
        <p class="hyb-stat__text">{{ s.text }}</p>
      </div>
      {% endfor %}
    </div>

    <div class="hyb-techniques hyb-reveal">
      <h3 class="hyb-techniques__kicker">{{ t.stats.techniques.kicker }}</h3>
      <ul class="hyb-chips">
        {% for tech in t.stats.techniques.items %}<li class="hyb-chip">{{ tech }}</li>{% endfor %}
      </ul>
      <p class="hyb-techniques__text">{{ t.stats.techniques.text }}</p>
    </div>
  </div>
</section>

{# ======================== 7. WHAT'S INCLUDED ===================== #}
<section class="hyb-section">
  <div class="hyb-wrap">
    <div class="hyb-included">
      <div class="hyb-reveal">
        <span class="hyb-eyebrow">{{ t.included.eyebrow }}</span>
        {% title t.included.title %}
        <p class="hyb-lead">{{ t.included.lead }}</p>
      </div>

      <ul class="hyb-included__list hyb-reveal">
        {% for item in t.included.items %}
        <li class="hyb-included__item">{{ item }}</li>
        {% endfor %}
      </ul>
    </div>
  </div>
</section>

{# ========================== 8. PRICING =========================== #}
<section class="hyb-section hyb-section--alt">
  <div class="hyb-wrap">
    <div class="hyb-price hyb-reveal">
      <span class="hyb-eyebrow hyb-eyebrow--gold">{{ t.pricing.eyebrow }}</span>
      {% title t.pricing.title, "h2", "hyb-title--lg" %}

      <div class="hyb-price__stats">
        {% for s in t.pricing.stats %}
        {% if not loop.first %}<div class="hyb-price__divider" aria-hidden="true"></div>{% endif %}
        <div class="hyb-price__stat">
          <p class="hyb-price__value">{{ s.value }}</p>
          <p class="hyb-price__label">{{ s.label }}</p>
        </div>
        {% endfor %}
      </div>

      <p class="hyb-price__note">{{ t.pricing.note }}</p>

      <div class="hyb-actions">
        <a href="#start" class="hyb-btn hyb-btn--primary">
          {{ t.pricing.cta }}
          <span class="hyb-btn__arrow" aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
  </div>
</section>

{# ========================= 9. FINAL CTA ========================== #}
<section class="hyb-section hyb-final" id="start">
  <div class="hyb-wrap">
    <div class="hyb-head hyb-reveal">
      <span class="hyb-eyebrow">{{ t.finalCta.eyebrow }}</span>
      {% title t.finalCta.title, "h2", "hyb-title--xl" %}
    </div>
    <p class="hyb-lead hyb-reveal">{{ t.finalCta.lead }}</p>
    {#
      Форма брифа.

      Данные пока никуда не уходят: обработчика на стороне сервера нет, и
      вместо него скрипт показывает благодарность. Действие оставлено на
      `mailto:` в action, а не пустым — без JS форма всё равно откроет письмо
      на тот же адрес, что и кнопки выше, а не перезагрузит страницу впустую.

      Точка подключения к бэкенду — сам элемент `form`: на живом сайте его
      подхватывает AjaxForm, ему нужен лишь адрес обработчика в action.

      Кнопок «Start a project» и «Book a free call» над формой больше нет:
      обе вели на тот же `mailto:`, что и форма, и стояли ровно там, где у
      посетителя уже есть поле ввода. Все ссылки `#start` со страницы ведут
      в эту секцию, и первое, что в ней есть после заголовка, — форма.

      Поля обёрнуты в label целиком, поэтому им не нужен ни id, ни for: в
      MODX разметка будет дублироваться на других страницах, и совпадение
      идентификаторов там — вопрос времени.
    #}
    {% set f = t.finalCta.form %}
    <form class="hyb-form hyb-reveal" data-hyb-form method="post"
          action="mailto:{{ site.contacts.email }}" enctype="text/plain">
      <div class="hyb-form__head">
        <span class="hyb-eyebrow">{{ f.eyebrow }}</span>
        <h3 class="hyb-form__title">{{ f.title }}</h3>
      </div>

      <div class="hyb-form__grid">
        <label class="hyb-field">
          <span class="hyb-field__label">{{ f.name.label }}</span>
          <input class="hyb-field__control" type="text" name="name" required
                 autocomplete="name" placeholder="{{ f.name.placeholder }}" />
        </label>

        <label class="hyb-field">
          <span class="hyb-field__label">{{ f.email.label }}</span>
          <input class="hyb-field__control" type="email" name="email" required
                 autocomplete="email" placeholder="{{ f.email.placeholder }}" />
        </label>

        <label class="hyb-field hyb-field--wide">
          <span class="hyb-field__label">
            {{ f.company.label }}
            <span class="hyb-field__hint">{{ f.optional }}</span>
          </span>
          <input class="hyb-field__control" type="text" name="company"
                 autocomplete="organization" placeholder="{{ f.company.placeholder }}" />
        </label>

        <label class="hyb-field hyb-field--wide">
          <span class="hyb-field__label">{{ f.message.label }}</span>
          <textarea class="hyb-field__control hyb-field__control--area" name="message"
                    rows="4" required placeholder="{{ f.message.placeholder }}"></textarea>
        </label>
      </div>

      <div class="hyb-form__foot">
        <button class="hyb-btn hyb-btn--primary" type="submit">
          {{ f.submit }}
          <span class="hyb-btn__arrow" aria-hidden="true">↗</span>
        </button>
      </div>

      {#
        Ответ формы читается вслух: role="status" сообщает скринридеру об
        изменении, не уводя фокус с кнопки.
      #}
      <p class="hyb-form__status" data-hyb-form-status role="status" hidden>{{ f.success }}</p>
    </form>
  </div>
</section>
