---
layout: layouts/base.njk
pagination:
  data: i18n
  size: 1
  alias: t
  resolve: values
permalink: "{{ t.dir }}studio/index.html"
eleventyComputed:
  pageTitle: "{{ t.pages.studio.title | safe }}"
  pageDescription: "{{ t.pages.studio.description | safe }}"
  altUrl: "{{ t.otherLocale.dir }}studio/"
---

<section class="hyb-pagehead">
  <div class="hyb-wrap">
    <div class="hyb-head hyb-head--full">
      <span class="hyb-eyebrow hyb-eyebrow--pill">{{ t.studioStats.pageEyebrow }}</span>
      {% title t.studioStats.title, "h1", "hyb-title--page" %}
      <p class="hyb-lead">{{ t.studioStats.pageLead }}</p>
    </div>
  </div>
</section>

{% set showHead = false %}
{% include "partials/sections/studio-stats.njk" %}
{% include "partials/sections/lets-talk.njk" %}
